<Window x:Class="DanbooruTagTool.App.ForgeSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forge連携設定" Width="700" Height="310" MinWidth="600" MinHeight="260"
        WindowStartupLocation="CenterOwner" Background="#F4F7FA" FontFamily="Yu Gothic UI" FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D8E3EC"/>
        <SolidColorBrush x:Key="InkBrush" Color="#17345E"/>
        <SolidColorBrush x:Key="MutedInkBrush" Color="#61748B"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1478E8"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0"/></Style>
        <Style TargetType="Button"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="MinHeight" Value="32"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="MinHeight" Value="32"/></Style>
        <Style x:Key="PanelBorder" TargetType="Border"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/></Style>
    </Window.Resources>
    <Border Margin="14" Style="{StaticResource PanelBorder}" Padding="14">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Forge連携設定" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="1" Text="ローカルのForge連携拡張へPromptを送ります。画像生成やGenerate操作は行いません。" Foreground="{StaticResource MutedInkBrush}" Margin="0,3,0,12"/>
            <Grid Grid.Row="2" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Forge URL" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding ForgeUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="既定: http://127.0.0.1:7860"/></Grid>
            <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="extensionsフォルダ" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,7,0,0"/><TextBox Grid.Column="1" Text="{Binding ForgeExtensionPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Forge本体、またはextensionsフォルダを指定"/><Button Grid.Column="2" Content="フォルダ選択" Click="ChooseFolderClick" Margin="8,0,0,0"/></Grid>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="125,14,0,0"><Button Content="保存" Command="{Binding SaveForgeSettings}" Style="{StaticResource PrimaryButton}"/><Button Content="拡張を配置" Click="InstallClick"/><Button Content="閉じる" Click="CloseClick" Margin="0"/></StackPanel>
        </Grid>
    </Border>
</Window>

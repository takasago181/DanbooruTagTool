<Window x:Class="DanbooruTagTool.App.Issue76BrowsePrototypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DanbooruTagTool.App.ViewModels"
        Title="Issue #76 Special Browse v2 Prototype"
        Width="1320" Height="820" MinWidth="960" MinHeight="620"
        FontFamily="Yu Gothic UI" FontSize="14" Background="#F4F7FA">
    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:NavigationNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Label}" Margin="3,6"/>
        </HierarchicalDataTemplate>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8E3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="FacetToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#F7FAFC"/>
            <Setter Property="BorderBrush" Value="#C8D7E3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#DDEEFF"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#1478E8"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.86"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="#FFF4D6" BorderBrush="#E5C66B" BorderThickness="1" CornerRadius="7" Padding="9,5">
                    <TextBlock Text="Issue #76 試作 · 本番未反映" Foreground="#795D18" FontWeight="SemiBold"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Special Browse v2" FontSize="22" FontWeight="Bold" Foreground="#17345E"/>
                    <TextBlock Text="種類・部位・テーマを交差して、細かい階層なしで探しやすさを検証します。" Foreground="#61748B" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="起点から探す" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="左の選択は新しい起点です。以前の絞り込みは解除されます。" Foreground="#61748B" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TreeView ItemsSource="{Binding Navigation}" SelectedItemChanged="NavigationChanged" Background="Transparent" BorderThickness="0"/>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1"/>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" ToolTip="既存SearchEngineで検索し、facetは結果を絞るだけです"/>
                        <TextBlock Grid.Column="1" Text="{Binding ResultSummary}" VerticalAlignment="Center" Margin="10,0" FontWeight="SemiBold"/>
                        <ComboBox Grid.Column="2" SelectedIndex="{Binding SortIndex}" Width="120" Height="32" IsEnabled="{Binding IsSearching, Converter={StaticResource BoolVisibility}, ConverterParameter=invert}">
                            <ComboBoxItem Content="使用数 ↓"/><ComboBoxItem Content="日本語名"/>
                        </ComboBox>
                    </Grid>

                    <Border Grid.Row="1" Background="#F7FAFC" BorderBrush="#D8E3EC" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,0,0,8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="すべて解除" Command="{Binding ClearFacets}" Padding="9,4" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding AppliedSummary}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2" Background="#FBFDFF" BorderBrush="#D8E3EC" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="絞り込み · 選んだ条件を全部含むタグだけ表示" FontWeight="SemiBold" Margin="0,0,0,7"/>
                            <TextBlock Text="種類" Foreground="#61748B" FontSize="12" Margin="0,0,0,3"/>
                            <ItemsControl ItemsSource="{Binding KindOptions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><ToggleButton Content="{Binding Display}" IsChecked="{Binding Selected, Mode=OneWay}" Command="{Binding DataContext.ToggleFacet, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource FacetToggle}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <TextBlock Text="部位（複数選択はAND）" Foreground="#61748B" FontSize="12" Margin="0,3,0,3"/>
                            <ItemsControl ItemsSource="{Binding BodyOptions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><ToggleButton Content="{Binding Display}" IsChecked="{Binding Selected, Mode=OneWay}" Command="{Binding DataContext.ToggleFacet, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource FacetToggle}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <TextBlock Text="テーマ（複数選択はAND）" Foreground="#61748B" FontSize="12" Margin="0,3,0,3"/>
                            <ItemsControl ItemsSource="{Binding ThemeOptions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><ToggleButton Content="{Binding Display}" IsChecked="{Binding Selected, Mode=OneWay}" Command="{Binding DataContext.ToggleFacet, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource FacetToggle}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </Border>

                    <ListBox Grid.Row="3" ItemsSource="{Binding Results}" Background="White" BorderBrush="#D8E3EC" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate><DataTemplate><Grid Margin="8,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding English}" Foreground="#61748B" FontSize="12"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Usage}" Foreground="#61748B" VerticalAlignment="Top" Margin="12,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

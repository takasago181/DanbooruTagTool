<Window x:Class="DanbooruTagTool.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:DanbooruTagTool.App.ViewModels"
 Title="DanbooruTagTool" Width="1280" Height="820" MinWidth="900" MinHeight="560" FontFamily="Yu Gothic UI" FontSize="14" Background="#F5F7F8" PreviewKeyDown="WindowKeyDown">
 <Window.Resources>
  <HierarchicalDataTemplate DataType="{x:Type vm:NavigationNode}" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Label}" Margin="3,7" MaxWidth="250"/></HierarchicalDataTemplate>
  <DataTemplate x:Key="EntryTemplate">
   <Grid Margin="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding English}" Foreground="#596570" FontSize="12"/></StackPanel>
    <TextBlock Grid.Column="1" Text="{Binding Usage}" TextAlignment="Right" VerticalAlignment="Center" Margin="8"/>
    <Button Grid.Column="2" Content="{Binding AddLabel}" Command="{Binding Add}" VerticalAlignment="Center"/>
   </Grid>
  </DataTemplate>
  <Style x:Key="ChipBorder" TargetType="Border">
   <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD5DC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="4"/>
   <Style.Triggers><DataTrigger Binding="{Binding Match}" Value="True"><Setter Property="Background" Value="#FFF1B5"/></DataTrigger><DataTrigger Binding="{Binding Selected}" Value="True"><Setter Property="BorderBrush" Value="#176B82"/><Setter Property="Background" Value="#DDEFF3"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers>
  </Style>
 </Window.Resources>
 <DockPanel Margin="12">
  <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
   <Button Content="クリップボードから読込" Command="{Binding Import}"/><Button Content="新規Prompt" Command="{Binding New}"/>
   <Button Content="直前のPromptを復元" Command="{Binding Recover}"/><Button Content="英語Promptをコピー" Command="{Binding Copy}"/>
  </WrapPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="#176B82" MinHeight="26" Margin="5"/>
  <TabControl x:Name="Workspaces" SelectedIndex="{Binding WorkspaceIndex}" SelectionChanged="WorkspaceChanged" Background="Transparent">
   <TabItem Header="辞書・検索">
    <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="210" MinWidth="145"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="260"/><ColumnDefinition Width="5"/><ColumnDefinition x:Name="PromptColumn" Width="340" MinWidth="210"/></Grid.ColumnDefinitions>
     <DockPanel><Button DockPanel.Dock="Top" Content="戻る" Command="{Binding Back}"/><TreeView x:Name="NavigationTree" ItemsSource="{Binding Navigation}" SelectedItemChanged="NavigationChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></DockPanel>
     <GridSplitter Grid.Column="1" DragCompleted="SplitterChanged"/>
     <Grid Grid.Column="2" Margin="10,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="0.65*" MinHeight="120"/></Grid.RowDefinitions>
      <DockPanel><Button DockPanel.Dock="Right" Content="クリア" Command="{Binding ClearQuery}"/><TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" TextChanged="SearchChanged" AutomationProperties.Name="日本語・English・混在検索" ToolTip="日本語・English・混在検索"/></DockPanel>
      <StackPanel Grid.Row="1"><DockPanel><ComboBox DockPanel.Dock="Right" SelectedIndex="{Binding SortIndex}" Width="125" Margin="5"><ComboBoxItem Content="使用数 ↓"/><ComboBoxItem Content="日本語名"/></ComboBox><TextBlock Text="{Binding BrowseLabel}" VerticalAlignment="Center" Margin="5"/></DockPanel><TextBlock Text="{Binding Pending}" Margin="5"/></StackPanel>
      <ListBox x:Name="DictionaryList" Grid.Row="2" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedEntry}" ItemTemplate="{StaticResource EntryTemplate}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.ScrollChanged="BrowseScrolled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
      <GridSplitter Grid.Row="3" Height="5" ResizeDirection="Rows"/>
      <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="6">
       <TextBlock Text="{Binding Detail}"/><Button Content="Promptへ追加" Command="{Binding SelectedEntry.Add}" HorizontalAlignment="Left"/>
       <TextBlock Text="同じ分類のSpecial" FontWeight="SemiBold" Margin="0,12,0,4"/>
       <ItemsControl ItemsSource="{Binding Related}" ItemTemplate="{StaticResource EntryTemplate}"/>
      </StackPanel></ScrollViewer>
     </Grid>
     <GridSplitter Grid.Column="3" DragCompleted="SplitterChanged"/>
     <DockPanel Grid.Column="4" Margin="10,0,0,0">
      <StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding Count}" FontSize="18" FontWeight="SemiBold"/><CheckBox Content="EN表示（通常は日本語）" IsChecked="{Binding EnglishChips}" Margin="4,12"/><TextBlock Text="{Binding Unresolved}" Foreground="#775522"/></StackPanel>
      <StackPanel DockPanel.Dock="Bottom"><Button Content="Prompt編集を開く" Command="{Binding OpenEditor}"/><Button Content="英語Promptをコピー" Command="{Binding Copy}"/></StackPanel>
      <ScrollViewer x:Name="CurrentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Chips}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
       <Button Command="{Binding DataContext.Inspect, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" MaxWidth="{Binding ActualWidth, ElementName=CurrentScroll}" Background="White"><TextBlock Text="{Binding Label}" MaxWidth="{Binding ActualWidth, ElementName=CurrentScroll}"/></Button>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     </DockPanel>
    </Grid>
   </TabItem>
   <TabItem Header="Prompt編集">
    <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition x:Name="EditorColumn" Width="7*" MinWidth="350"/><ColumnDefinition Width="5"/><ColumnDefinition x:Name="EnglishColumn" Width="3*" MinWidth="225"/></Grid.ColumnDefinitions>
     <DockPanel Margin="0,0,10,0">
      <WrapPanel DockPanel.Dock="Top"><CheckBox Content="複数選択" IsChecked="{Binding MultiSelect}" VerticalAlignment="Center" Margin="8"/><Button Content="選択を削除" Command="{Binding Delete}"/><Button Content="Undo" Command="{Binding Undo}"/><Button Content="Redo" Command="{Binding Redo}"/></WrapPanel>
      <DockPanel DockPanel.Dock="Top"><TextBlock Text="Prompt内検索" VerticalAlignment="Center"/><TextBox x:Name="FindBox" Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}" KeyDown="FindKeyDown" AutomationProperties.Name="Prompt内検索"/></DockPanel>
      <WrapPanel DockPanel.Dock="Bottom" Visibility="{Binding WeightVisible, Converter={StaticResource BoolVisibility}}"><TextBlock Text="weight" VerticalAlignment="Center"/><TextBox Text="{Binding Weight}" Width="95"/><Button Content="適用" Command="{Binding ApplyWeight}"/></WrapPanel>
      <Grid><ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowDrop="True" DragOver="EditorDragOver" Drop="EditorDrop" DragLeave="EditorDragLeave">
       <ItemsControl x:Name="EditorItems" ItemsSource="{Binding Chips}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
        <Border x:Name="EditorChip" Style="{StaticResource ChipBorder}" MaxWidth="{Binding ActualWidth, ElementName=EditorScroll}" PreviewMouseLeftButtonDown="ChipMouseDown" PreviewMouseLeftButtonUp="ChipMouseUp" PreviewMouseMove="ChipMouseMove">
         <DockPanel><Button DockPanel.Dock="Right" Content="×" Command="{Binding DataContext.DeleteOne, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="2" Margin="6,0,0,0" MinHeight="20" Width="22"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, ElementName=EditorChip}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><TextBlock Text="{Binding Item.Display}" VerticalAlignment="Center"/></DockPanel>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </ScrollViewer><Canvas IsHitTestVisible="False" ClipToBounds="True"><Border x:Name="InsertionMarker" Background="#176B82" Width="4" Height="35" Visibility="Collapsed"/></Canvas></Grid>
     </DockPanel>
     <GridSplitter Grid.Column="1" DragCompleted="SplitterChanged"/>
     <DockPanel Grid.Column="2" Margin="12,0,0,0">
      <TextBlock DockPanel.Dock="Top" Text="実際のEnglish Prompt" FontSize="18" FontWeight="SemiBold" Margin="3,4,3,12"/>
      <StackPanel DockPanel.Dock="Bottom"><Button Content="英語Promptをコピー" Command="{Binding Copy}"/><Button Content="英語Promptを直接編集" Command="{Binding StartDirect}"/><WrapPanel Visibility="{Binding DirectEditing, Converter={StaticResource BoolVisibility}}"><Button Content="直接編集を適用" Command="{Binding ApplyDirect}"/><Button Content="キャンセル" Command="{Binding CancelDirect}"/></WrapPanel></StackPanel>
      <Grid><TextBox x:Name="EnglishPreview" Text="{Binding English, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="実際のEnglish Prompt"/><TextBox x:Name="DirectEditor" Text="{Binding DirectText, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding DirectEditing, Converter={StaticResource BoolVisibility}}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="英語Prompt直接編集"/></Grid>
     </DockPanel>
    </Grid>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>

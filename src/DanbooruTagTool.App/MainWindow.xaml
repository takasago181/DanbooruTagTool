{StaticResource HintText}" VerticalAlignment="Bottom" Margin="6,0,6,2" IsHitTestVisible="False"/><Canvas IsHitTestVisible="False" ClipToBounds="True"><Border x:Name="InsertionMarker" Background="{StaticResource PrimaryBrush}" Width="4" Height="38" Visibility="Collapsed" CornerRadius="2"/></Canvas></Grid></Border>

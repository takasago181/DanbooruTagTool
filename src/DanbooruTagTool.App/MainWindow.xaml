<Window x:Class="DanbooruTagTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DanbooruTagTool.App.ViewModels"
        xmlns:core="clr-namespace:DanbooruTagTool.Core;assembly=DanbooruTagTool.Core"
        Title="DanbooruTagTool v1"
        Width="1280" Height="720" MinWidth="900" MinHeight="560"
        WindowState="Maximized"
        FontFamily="Yu Gothic UI" FontSize="14"
        Background="#F4F7FA" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="WindowKeyDown">
    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:NavigationNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Label}" Margin="3,7" MaxWidth="250"/>
        </HierarchicalDataTemplate>
        <SolidColorBrush x:Key="AppBackground" Color="#F4F7FA"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="WorkSurfaceBrush" Color="#F8FBFD"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D8E3EC"/>
        <SolidColorBrush x:Key="BorderBrushStrong" Color="#B9CBD9"/>
        <SolidColorBrush x:Key="InkBrush" Color="#17345E"/>
        <SolidColorBrush x:Key="MutedInkBrush" Color="#61748B"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1478E8"/>
        <SolidColorBrush x:Key="SoftBlueBrush" Color="#E8F2FF"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FFF1F0"/>
        <SolidColorBrush x:Key="DangerBorderBrush" Color="#E6B2AD"/>
        <SolidColorBrush x:Key="MatchBrush" Color="#FFF4C7"/>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.72"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource SoftBlueBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="#B9D4F4"/>
        </Style>
        <Style x:Key="GhostButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
            <Setter Property="Foreground" Value="#8A3F39"/>
        </Style>
        <Style x:Key="CompactButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="CompactPrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="CompactSecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="AddStateButton" TargetType="Button" BasedOn="{StaticResource CompactSecondaryButton}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#DCEBFA"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="#F0F4F8"/><Setter Property="Foreground" Value="#49627B"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ModeToggleButton" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="{StaticResource SoftBlueBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="#B9D4F4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ToggleChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleChrome" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleChrome" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ToggleChrome" Property="Opacity" Value="0.42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>
        <Style x:Key="PanelSubtitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="HintText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}"/>
        </Style>
        <Style x:Key="StatusText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#176B82"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="4,8,4,0"/>
            <Setter Property="MinHeight" Value="22"/>
        </Style>
        <Style x:Key="HeaderCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20,16"/>
        </Style>
        <Style x:Key="PanelCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="ToolbarCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#F5F9FD"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>
        <Style x:Key="WorkSurfaceCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource WorkSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="AuxiliaryCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#F5F9FD"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
        <Style x:Key="PreviewCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#FBFDFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="PreviewTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="ChipCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Item.Kind}" Value="{x:Static core:PromptItemKind.Raw}">
                    <Setter Property="Background" Value="#FFF9EC"/>
                    <Setter Property="BorderBrush" Value="#E3C98A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Match}" Value="True">
                    <Setter Property="Background" Value="{StaticResource MatchBrush}"/>
                    <Setter Property="BorderBrush" Value="#E5C44C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="BorderBrush" Value="#82B7EC"/>
                    <Setter Property="Background" Value="#F0F7FF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter Property="Background" Value="#DDEEFF"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CategoryChipCard" TargetType="{x:Type Border}" BasedOn="{StaticResource ChipCard}">
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="MaxWidth" Value="280"/>
        </Style>
        <Style x:Key="PromptPreviewChip" TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="#F2F7FC"/>
            <Setter Property="BorderBrush" Value="#E0EAF2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="11,8"/>
        </Style>
        <Style TargetType="{x:Type GridSplitter}">
            <Setter Property="Background" Value="#D7E2EC"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabChrome" Background="#EAF0F5" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9,9,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="#F3F8FD"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RightDetailsTabItem" TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style x:Key="NavigationItem" TargetType="{x:Type TreeViewItem}">
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F2F6FA"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F7F9FB"/>
                    <Setter Property="BorderBrush" Value="#9DBDDF"/>
                    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DictionaryRow" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="RowChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowChrome" Property="Background" Value="#F4F7FA"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowChrome" Property="Background" Value="#F1F5F9"/><Setter TargetName="RowChrome" Property="BorderBrush" Value="#9DBDDF"/><Setter TargetName="RowChrome" Property="BorderThickness" Value="2,0,0,0"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="EntryTemplate">
            <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,4,8" MinHeight="68" Width="{Binding DataContext.DictionaryCardWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,4"/>
                    <TextBlock Grid.Column="1" Text="{Binding Usage}" Foreground="{StaticResource MutedInkBrush}" TextAlignment="Right" VerticalAlignment="Top" Margin="4,0,8,4"/>
                    <Button Grid.Column="2" Content="{Binding AddSymbol}" ToolTip="{Binding DetailAddLabel}" ToolTipService.ShowOnDisabled="True" Command="{Binding Add}" Style="{StaticResource AddStateButton}" MinWidth="40" Padding="8,3" VerticalAlignment="Top" Margin="0"/>
                    <TextBlock Grid.Row="1" Text="{Binding English}" Foreground="{StaticResource MutedInkBrush}" FontSize="12" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Style="{StaticResource HeaderCard}" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DanbooruTagTool v1" Style="{StaticResource PageTitle}" FontSize="20"/>
                    <TextBlock Text="タグを探して、選んで、Promptへ追加します。" Style="{StaticResource PanelSubtitle}" Margin="0,2,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="共通操作" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Content="クリップボードから読込" Command="{Binding Import}" Style="{StaticResource CompactPrimaryButton}"/>
                    <Button Content="新規Prompt" Command="{Binding New}" Style="{StaticResource CompactSecondaryButton}"/>
                    <Button Content="直前のPromptを復元" Command="{Binding Recover}" Style="{StaticResource CompactSecondaryButton}"/>
                    <Button Content="英語Promptをコピー" Command="{Binding Copy}" Style="{StaticResource CompactButton}"/>
                </WrapPanel>
            </Grid>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource StatusText}"/>

        <TabControl x:Name="Workspaces" SelectedIndex="{Binding WorkspaceIndex}" SelectionChanged="WorkspaceChanged" Margin="0,8,0,0">
            <TabItem Header="辞書・検索" IsEnabled="{Binding CanEditPrompt}">
                <DockPanel>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="300" MinWidth="240"/><ColumnDefinition Width="8"/><ColumnDefinition Width="3*" MinWidth="320"/><ColumnDefinition Width="8"/><ColumnDefinition x:Name="PromptColumn" Width="400" MinWidth="360"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top"><TextBlock Text="タグを探す" Style="{StaticResource PanelTitle}" FontSize="16"/><TextBlock Text="Specialはジャンルから発見できます。" Style="{StaticResource PanelSubtitle}" Margin="0,0,0,6"/></StackPanel>
                            <Button DockPanel.Dock="Top" Content="← 戻る" Command="{Binding Back}" Style="{StaticResource CompactButton}" HorizontalContentAlignment="Left"/>
                            <TreeView x:Name="NavigationTree" ItemsSource="{Binding Navigation}" ItemContainerStyle="{StaticResource NavigationItem}" SelectedItemChanged="NavigationChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="2,0,8,0">
                                <TreeView.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#F7F9FB"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#17345E"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#F7F9FB"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#17345E"/>
                                </TreeView.Resources>
                            </TreeView>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Column="1" DragCompleted="SplitterChanged"/>
                    <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="タグ辞書" Style="{StaticResource PanelTitle}" FontSize="16"/><TextBlock Text="日本語・English・混在検索" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource ToolbarCard}" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Prompt履歴" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,6,0"/><Button Content="元に戻す" ToolTip="Promptを元に戻す" Command="{Binding Undo}" Style="{StaticResource CompactButton}" Margin="0,0,4,0"/><Button Content="やり直す" ToolTip="Promptをやり直す" Command="{Binding Redo}" Style="{StaticResource CompactButton}" Margin="0"/></StackPanel>
                                </Border>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" TextChanged="SearchChanged" AutomationProperties.Name="日本語・English・混在検索" ToolTip="日本語・English・混在検索" Padding="9,6"/>
                                <Button Grid.Column="1" Content="クリア" Command="{Binding ClearQuery}" Style="{StaticResource CompactButton}" Margin="6,0,8,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding ResultSummary}" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Grid Grid.Column="3" MinWidth="105">
                                    <ComboBox SelectedIndex="{Binding SortIndex}" IsEnabled="{Binding CanBrowseSort}" Height="30"><ComboBox.Style><Style TargetType="ComboBox"><Style.Triggers><DataTrigger Binding="{Binding IsSearching}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style><ComboBoxItem Content="使用数 ↓"/><ComboBoxItem Content="日本語名"/></ComboBox>
                                    <TextBlock Text="関連度順" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsSearching, Converter={StaticResource BoolVisibility}}"/>
                                </Grid>
                            </Grid>
                            <DockPanel Grid.Row="2" Margin="0,0,0,6"><TextBlock Text="{Binding BrowseLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="  ·  " Foreground="{StaticResource MutedInkBrush}" VerticalAlignment="Center"/><TextBlock Text="{Binding Pending}" Style="{StaticResource HintText}" VerticalAlignment="Center"/></DockPanel>

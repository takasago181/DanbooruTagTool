<Window x:Class="DanbooruTagTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DanbooruTagTool.App.ViewModels"
        xmlns:views="clr-namespace:DanbooruTagTool.App.Views"
        xmlns:core="clr-namespace:DanbooruTagTool.Core;assembly=DanbooruTagTool.Core"
        Title="DanbooruTagTool v1"
        Width="1280" Height="720" MinWidth="900" MinHeight="560"
        WindowState="Maximized"
        FontFamily="Noto Sans JP" FontSize="14"
        Background="#F4F7FA" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        AllowDrop="True"
        DragOver="WindowDragOver"
        Drop="WindowDrop"
        PreviewKeyDown="WindowKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BrowseHomeVisibility"/>
        <HierarchicalDataTemplate DataType="{x:Type vm:NavigationNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Label}" Margin="3,4" MaxWidth="{DynamicResource NavigationLabelWidth}" FontSize="13.5" FontWeight="Medium"/>
        </HierarchicalDataTemplate>
        <SolidColorBrush x:Key="AppBackground" Color="#F4F7FA"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="WorkSurfaceBrush" Color="#F8FBFD"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D8E3EC"/>
        <SolidColorBrush x:Key="BorderBrushStrong" Color="#B9CBD9"/>
        <SolidColorBrush x:Key="InkBrush" Color="#17345E"/>
        <SolidColorBrush x:Key="MutedInkBrush" Color="#61748B"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1478E8"/>
        <SolidColorBrush x:Key="SoftBlueBrush" Color="#E8F2FF"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FFF1F0"/>
        <SolidColorBrush x:Key="DangerBorderBrush" Color="#E6B2AD"/>
        <SolidColorBrush x:Key="MatchBrush" Color="#FFF4C7"/>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#1478E8"/><Setter TargetName="ButtonChrome" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.72"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource SoftBlueBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="#B9D4F4"/>
        </Style>
        <Style x:Key="GhostButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
            <Setter Property="Foreground" Value="#8A3F39"/>
        </Style>
        <Style x:Key="CompactButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="CompactPrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="CompactSecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="AddStateButton" TargetType="Button" BasedOn="{StaticResource CompactSecondaryButton}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#F7FAFD"/>
            <Setter Property="BorderBrush" Value="#C4D5E2"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#DCEBFA"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="#F0F4F8"/><Setter Property="Foreground" Value="#49627B"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AddSymbol}" Value="✓">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AddSymbol}" Value="参照">
                    <Setter Property="Background" Value="#F2F5F8"/>
                    <Setter Property="BorderBrush" Value="#D5DEE6"/>
                    <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModeToggleButton" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="{StaticResource SoftBlueBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="#B9D4F4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ToggleChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleChrome" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleChrome" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ToggleChrome" Property="Opacity" Value="0.42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>
        <Style x:Key="PanelSubtitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="HintText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}"/>
        </Style>
        <Style x:Key="StatusText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#176B82"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="4,8,4,0"/>
            <Setter Property="MinHeight" Value="22"/>
        </Style>
        <Style x:Key="HeaderCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20,16"/>
        </Style>
        <Style x:Key="PanelCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="ToolbarCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#F5F9FD"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>
        <Style x:Key="WorkSurfaceCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#F6FAFD"/>
            <Setter Property="BorderBrush" Value="#CFDDE8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="AuxiliaryCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#F5F9FD"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
        <Style x:Key="PreviewCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#FBFDFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="PreviewTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="ChipCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="#C4D5E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="3"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Item.Kind}" Value="{x:Static core:PromptItemKind.Raw}">
                    <Setter Property="Background" Value="#FFF9EC"/>
                    <Setter Property="BorderBrush" Value="#E3C98A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Match}" Value="True">
                    <Setter Property="Background" Value="{StaticResource MatchBrush}"/>
                    <Setter Property="BorderBrush" Value="#E5C44C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="BorderBrush" Value="#82B7EC"/>
                    <Setter Property="Background" Value="#F0F7FF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter Property="Background" Value="#DDEEFF"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CategoryChipCard" TargetType="{x:Type Border}" BasedOn="{StaticResource ChipCard}">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="MaxWidth" Value="280"/>
        </Style>
        <Style x:Key="PromptPreviewChip" TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C4D5E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>
        <Style x:Key="PromptPanePrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource CompactPrimaryButton}">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="PromptPaneSecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource CompactSecondaryButton}">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="ItemDeleteButton" TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#718398"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,3,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF0EE"/>
                    <Setter Property="BorderBrush" Value="#E6B0AA"/>
                    <Setter Property="Foreground" Value="#8A3F39"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#F7DAD6"/>
                    <Setter Property="BorderBrush" Value="#D9968E"/>
                    <Setter Property="Foreground" Value="#71312C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionSurface" TargetType="{x:Type Border}" BasedOn="{StaticResource WorkSurfaceCard}">
            <Setter Property="Background" Value="#FBFDFF"/>
            <Setter Property="BorderBrush" Value="#C6D9E8"/>
        </Style>
        <Style x:Key="PromptSectionSurface" TargetType="{x:Type Border}" BasedOn="{StaticResource WorkSurfaceCard}">
            <Setter Property="Background" Value="#F2F8FD"/>
            <Setter Property="BorderBrush" Value="#B9D3E7"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#EAF4FC"/>
            <Setter Property="BorderBrush" Value="#D2E3F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style TargetType="{x:Type GridSplitter}">
            <Setter Property="Background" Value="#D7E2EC"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabChrome" Background="#EAF0F5" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9,9,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="#F3F8FD"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkspaceTabItem" TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid>
                            <Border x:Name="TabChrome" Background="#EAF0F5" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9,9,0,0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="SelectedEdge" Height="3" Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="-1,0,-1,-1" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="SelectedEdge" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="#F3F8FD"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavigationItem" TargetType="{x:Type TreeViewItem}">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EDF5FB"/>
                </Trigger>
                <Trigger Property="HasItems" Value="True">
                    <Setter Property="FontWeight" Value="Medium"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="Background" Value="#F5F9FC"/>
                    <Setter Property="IsExpanded" Value="True"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E5F2FF"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DictionaryRow" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="RowChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowChrome" Property="Background" Value="#F4F7FA"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowChrome" Property="Background" Value="#EAF4FC"/><Setter TargetName="RowChrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/><Setter TargetName="RowChrome" Property="BorderThickness" Value="2,0,0,0"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DictionaryCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C4D5E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="0,0,4,5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="#E5F2FF"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#F2F8FD"/>
                    <Setter Property="BorderBrush" Value="#82B7EC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="EntryTemplate">
            <Border Style="{StaticResource DictionaryCard}" MinHeight="58" Width="{Binding DataContext.DictionaryCardWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="Medium" TextWrapping="Wrap" Margin="0,0,8,2"/>
                    <TextBlock Grid.Column="1" Text="{Binding Usage}" FontSize="12" FontWeight="Normal" Foreground="{StaticResource MutedInkBrush}" TextAlignment="Right" VerticalAlignment="Top" Margin="4,0,8,4"/>
                    <Button Grid.Column="2" Grid.RowSpan="3" Content="{Binding AddSymbol}" ToolTip="{Binding DetailAddLabel}" ToolTipService.ShowOnDisabled="True" Command="{Binding Add}" Style="{StaticResource AddStateButton}" MinWidth="36" Padding="6,2" VerticalAlignment="Center" Margin="0"/>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding English}" Foreground="{StaticResource MutedInkBrush}" FontSize="12" TextWrapping="Wrap"/>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal"
                                Visibility="{Binding HasRelated, Converter={StaticResource BrowseHomeVisibility}}" Margin="0,4,0,0">
                        <TextBlock Text="{Binding RelationSummary}" Foreground="{StaticResource MutedInkBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="{Binding RelatedActionLabel}" Command="{Binding OpenRelated}" Style="{StaticResource CompactButton}" Padding="6,2" MinHeight="24" Margin="0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="12">
        <Border x:Name="GlobalHeader" DockPanel.Dock="Top" Style="{StaticResource HeaderCard}" Padding="12,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="設定" Command="{Binding OpenForgeSettings}" Style="{StaticResource CompactButton}"/>
                <TextBlock Text="DanbooruTagTool" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding Forge.ConnectionStatus}" VerticalAlignment="Center" ToolTip="requested ModelとForgeで実際にloadedなModelは別です。未照会の実状態は未確認。"/>
            </DockPanel>
        </Border>
        <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="70" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}"/></ScrollViewer>

        <TabControl x:Name="Workspaces" SelectedIndex="{Binding ShellWorkspaceIndex}" SelectionChanged="WorkspaceChanged" Margin="0,8,0,0">
            <TabItem Header="作成" Style="{StaticResource WorkspaceTabItem}">
              <DockPanel>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource WorkSurfaceCard}" Padding="4" Margin="0,4,0,0" Visibility="{Binding CreateComposerVisible, Converter={StaticResource BrowseHomeVisibility}}">
                 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
                  <ScrollViewer MaxHeight="60" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding Create.SourceSummary}" FontWeight="SemiBold"/><TextBlock Text="{Binding Create.ConditionsSummary}" FontSize="12"/><TextBlock Text="{Binding Create.Validation}" FontSize="12"/></StackPanel></ScrollViewer>
                  <Button x:Name="PrimaryGenerate" Grid.Column="1" Content="生成" Command="{Binding Create.Generate}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" ToolTipService.ShowOnDisabled="True" ToolTip="現在のPositive / Negative / 表示された生成条件で1画像生成し、実画像metadataと照合します。条件不足や不一致時は失敗し、互換生成へfallbackしません。"/>
                  <Button Content="その他 ▾" Click="CreateMoreClick" Style="{StaticResource CompactButton}" Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Center">
                   <Button.ContextMenu><ContextMenu>
                    <MenuItem Header="PNGを読込" Click="ImportGenerationPngClick"/>
                    <MenuItem Header="Positive: クリップボードから読込（置換）" Command="{Binding Prompt.Import}"/>
                    <MenuItem Header="Positive: 新規" Command="{Binding Prompt.New}"/>
                    <MenuItem Header="Positive: 回復" Command="{Binding Prompt.Recover}"/>
                    <Separator/>
                    <MenuItem Header="Negative: クリップボードから読込（置換）" Command="{Binding Negative.Import}"/>
                    <MenuItem Header="Negative: 新規" Command="{Binding Negative.New}"/>
                    <MenuItem Header="Negative: 回復" Command="{Binding Negative.Recover}"/>
                    <Separator/>
                    <MenuItem Header="Forgeへ送るだけ（現在Positive・Negative変更なし）" Command="{Binding Forge.SendToForge}" ToolTip="DTTの生成条件は適用しません。生成しません。"/>
                    <MenuItem Header="Forgeの現在設定で生成（現在Positive・Negative変更なし）" Command="{Binding Forge.GenerateInForge}" ToolTip="DTTの生成条件は適用しません。Forgeの現在条件を使います。"/>
                    <MenuItem Header="Positive + Negativeを送るだけ（両側置換）" Command="{Binding Forge.SendWorkspacePair}" ToolTip="空Negativeも置換。DTTの生成条件は適用しません。生成しません。"/>
                    <Separator/>
                    <MenuItem Header="出力形式: 生成向け（Positive）" Click="GeneratorOutputClick"/>
                    <MenuItem Header="出力形式: 原形優先（Positive）" Click="CanonicalOutputClick"/>
                    <MenuItem Header="レイアウトを初期値へ" Click="ResetLayoutClick"/>
                   </ContextMenu></Button.ContextMenu>
                  </Button>
                 </Grid>
                </Border>
                <Expander DockPanel.Dock="Bottom" Header="Prompt診断 / token・chunk（警告のみ）" Margin="0,6" Visibility="{Binding CreateComposerVisible, Converter={StaticResource BrowseHomeVisibility}}">
                 <StackPanel MaxHeight="200"><WrapPanel><TextBlock Text="Counter Steps" VerticalAlignment="Center"/><TextBox Text="{Binding Intelligence.Steps}" Width="70"/><Button Content="Forge token照会" Click="TokenCountClick" ToolTip="生成しません。読み込み済みモデルのcounterを明示照会します。"/></WrapPanel><ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150"><StackPanel><TextBlock Text="{Binding Intelligence.TokenStatus}" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Intelligence.Boundaries}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Side}"/><Run Text=" node "/><Run Text="{Binding Node}"/><Run Text=" : "/><Run Text="{Binding Kind}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ItemsControl ItemsSource="{Binding Intelligence.Warnings}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></StackPanel>
                </Expander>
                <TabControl x:Name="PromptSides" SelectedIndex="{Binding CreatePageIndex}">
                 <TabItem Header="Positive"><views:PromptEditorView x:Name="PromptEditor" DataContext="{Binding Prompt}"/></TabItem>
                 <TabItem Header="Negative"><views:PromptEditorView x:Name="NegativeEditor" DataContext="{Binding Negative}"/></TabItem>
                 <TabItem Header="生成条件 / Preset"><views:GenerationConditionsView DataContext="{Binding}"/></TabItem>
                 <TabItem Header="LoRAを追加"><views:LoraQuickUseView DataContext="{Binding LoraLibrary}"/></TabItem>
                 <TabItem Header="A/B実験"><views:ExperimentLabView DataContext="{Binding Experiments}"/></TabItem>
                </TabControl>
              </DockPanel>
            </TabItem>
            <TabItem Header="タグ探索" IsEnabled="{Binding CanEditPrompt}" Style="{StaticResource WorkspaceTabItem}">
                <DockPanel>
                <Grid x:Name="DiscoveryLayout" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="300" MinWidth="240"/><ColumnDefinition Width="8"/><ColumnDefinition Width="3*" MinWidth="300"/><ColumnDefinition Width="8"/><ColumnDefinition x:Name="PromptColumn" Width="400" MinWidth="360"/></Grid.ColumnDefinitions>
                    <Border x:Name="DiscoveryNavigation" Grid.Column="0" Style="{StaticResource PanelCard}" Padding="12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top"><TextBlock Text="タグを探す" Style="{StaticResource PanelTitle}" FontSize="16"/><TextBlock Text="用途・部位・テーマからまとめて探します。" Style="{StaticResource PanelSubtitle}" Margin="0,0,0,6"/></StackPanel>
                            <TreeView x:Name="NavigationTree" ItemsSource="{Binding Navigation}" ItemContainerStyle="{StaticResource NavigationItem}" SelectedItemChanged="NavigationChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="2,0,8,0">
                                <TreeView.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#F7F9FB"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#17345E"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#F7F9FB"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#17345E"/>
                                </TreeView.Resources>
                            </TreeView>
                        </DockPanel>
                    </Border>
                    <GridSplitter Grid.Column="1" DragCompleted="SplitterChanged"/>
                    <views:DictionaryWorkspaceView x:Name="DictionaryWorkspace" DataContext="{Binding Dictionary}" Grid.Column="2"/>
                    <GridSplitter Grid.Column="3" DragCompleted="SplitterChanged"/>
                    <Border x:Name="DiscoveryPrompt" Grid.Column="4" Style="{StaticResource PanelCard}" Padding="10">
                        <Border Style="{StaticResource PromptSectionSurface}" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Grid.Row="0" Style="{StaticResource SectionHeader}" Padding="8,7" Margin="0,0,0,5"><StackPanel><WrapPanel><TextBlock Text="現在のPrompt" Style="{StaticResource PanelTitle}" FontSize="16" Margin="0"/><TextBlock Text="{Binding Count}" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="8,0,0,0"/><CheckBox DockPanel.Dock="Right" Content="EN表示" IsChecked="{Binding EnglishChips}" Margin="8,0,0,0" VerticalAlignment="Center"/></WrapPanel><TextBlock Text="{Binding Unresolved}" Style="{StaticResource HintText}" Foreground="#8A6A37"/></StackPanel></Border>
                                <Border Grid.Row="1" Style="{StaticResource WorkSurfaceCard}" Padding="8" Margin="0,4,0,10"><ScrollViewer x:Name="CurrentScroll" Padding="2,3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><ItemsControl ItemsSource="{Binding Chips}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="3"><Button Style="{StaticResource PromptPreviewChip}" Command="{Binding DataContext.Inspect, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" MaxWidth="{Binding ActualWidth, ElementName=CurrentScroll}" Padding="10,8,30,8" MinHeight="38" Margin="0"><TextBlock Text="{Binding Label}" FontWeight="Medium" TextWrapping="Wrap"/></Button><Button Content="×" Style="{StaticResource ItemDeleteButton}" Command="{Binding DataContext.DeleteOne, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="このPrompt項目を削除" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="まだPromptがありません。辞書から追加するか、Promptを読み込んでください。" Margin="6,10,6,6"><TextBlock.Style><Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource HintText}"><Style.Triggers><DataTrigger Binding="{Binding HasPrompt}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></ScrollViewer></Border>
                                <StackPanel Grid.Row="2"><Button Content="作成を開く" Command="{Binding OpenEditor}" Style="{StaticResource PromptPanePrimaryButton}"/><Button Content="英語Promptをコピー" Command="{Binding Copy}" Style="{StaticResource PromptPaneSecondaryButton}" Margin="0,6,0,0"/></StackPanel>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="ライブラリ" Style="{StaticResource WorkspaceTabItem}">
             <TabControl x:Name="LibrarySurfaces" SelectedIndex="{Binding LibrarySubtypeIndex}">
              <TabItem Header="生成画像"><views:GenerationLibraryView x:Name="GenerationLibraryWorkspace" DataContext="{Binding GenerationLibrary}"/></TabItem>
              <TabItem Header="LoRA"><views:LoraLibraryView x:Name="LoraLibraryWorkspace" DataContext="{Binding LoraLibrary}"/></TabItem>
             </TabControl>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

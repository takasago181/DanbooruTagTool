<Window x:Class="DanbooruTagTool.App.GenerationPresetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="生成プリセット" Width="860" Height="760" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F4F7FA" FontFamily="Yu Gothic UI" FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="WorkSurfaceBrush" Color="#F8FBFD"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D8E3EC"/>
        <SolidColorBrush x:Key="BorderBrushStrong" Color="#B9CBD9"/>
        <SolidColorBrush x:Key="InkBrush" Color="#17345E"/>
        <SolidColorBrush x:Key="MutedInkBrush" Color="#61748B"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1478E8"/>
        <SolidColorBrush x:Key="SoftBlueBrush" Color="#E8F2FF"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0"/></Style>
        <Style TargetType="Button"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="MinHeight" Value="32"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#FFF1F0"/><Setter Property="Foreground" Value="#8A3F39"/><Setter Property="BorderBrush" Value="#E6B2AD"/></Style>
        <Style x:Key="PanelBorder" TargetType="Border"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/></Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="新規" Command="{Binding NewPreset}" Style="{StaticResource PrimaryButton}" Margin="0"/>
            <StackPanel><TextBlock Text="生成プリセット" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="PositiveセットとNegative Promptをまとめて再利用できます。" Foreground="{StaticResource MutedInkBrush}" Margin="0,2,0,0"/></StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="保存済みプリセット" FontWeight="SemiBold" Margin="2,0,2,8"/>
                <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource WorkSurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="7" Padding="8" Margin="0,0,0,7">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Name}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Name}" Value="">
                                                        <Setter Property="Text" Value="（名前なし）"/>
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                        <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedInkBrush}" FontSize="12" MaxHeight="38" Margin="0,2,0,6"/>
                                    <WrapPanel>
                                        <Button Content="Positive追加" Command="{Binding DataContext.ApplyPreset, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,4" MinHeight="28"/>
                                        <Button Content="Negativeコピー" Command="{Binding DataContext.CopyPresetNegative, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,4" MinHeight="28" Margin="0"/>
                                        <Button Content="Forgeへ送る" Command="{Binding DataContext.SendPresetToForge, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,4" MinHeight="28" Margin="0" ToolTip="現在のvisible English Promptと、このプリセットのNegativeをForgeへ送ります。"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="プリセット編集" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="名前" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <TextBlock Text="説明" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding PresetDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <DockPanel Margin="0,0,0,3"><TextBlock Text="Positive" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="現在のPromptから取得" Command="{Binding CapturePresetPositive}" Padding="8,4" MinHeight="28" Margin="8,0,0,0"/></DockPanel>
                    <TextBox Text="{Binding PresetPositive, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" ToolTip="canonical形式または生成向け形式で入力できます。未解決部分はそのまま保持されます。"/>
                    <TextBlock Text="Negative" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding PresetNegative, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Content="保存" Command="{Binding SavePreset}" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="削除" Click="DeletePresetClick" Style="{StaticResource DangerButton}"/>
                    </WrapPanel>
                    <TextBlock Text="Positive追加時はrecognized canonicalの既存項目だけを重複skipします。Negativeは入力文字列をそのままコピーします。" Foreground="{StaticResource MutedInkBrush}" FontSize="12" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>

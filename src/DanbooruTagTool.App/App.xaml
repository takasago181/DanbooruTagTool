<Application x:Class="DanbooruTagTool.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="TextTrimming" Value="None"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="32"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="3"/></Style>
  <Style TargetType="GridSplitter"><Setter Property="Background" Value="#DFE5E8"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
 </Application.Resources>
</Application>

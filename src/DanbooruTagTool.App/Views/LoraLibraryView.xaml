<UserControl x:Class="DanbooruTagTool.App.Views.LoraLibraryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded" Background="#F4F7FA">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <WrapPanel IsEnabled="{Binding CanEdit}"><Button Content="LoRAフォルダー追加" Click="AddRootClick"/><Button Content="スキャン" Click="ScanClick"/><Button Content="明示hash検証" Click="VerifyClick" ToolTip="登録rootの全LoRAを再hashします。通常scanはsize/mtimeで省略します。"/><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" MinWidth="220"/><CheckBox Content="お気に入り" IsChecked="{Binding FavoriteOnly}"/><Button Content="検索 / 更新" Click="SearchClick"/><Button Content="前100" Click="PreviousClick"/><Button Content="次100" Click="NextClick"/></WrapPanel>
  <Grid Grid.Row="1" Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="440"/></Grid.ColumnDefinitions>
   <DockPanel><ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Roots}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <ListBox ItemsSource="{Binding Assets}" SelectedItem="{Binding Selected}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" TextWrapping="Wrap" FontSize="11"/><TextBlock Text="{Binding Sha256}" FontSize="10"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   </DockPanel>
   <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding CanEdit}">
    <Image x:Name="PreviewImage" MaxHeight="200" Stretch="Uniform"/>
    <TextBlock Text="{Binding Selected.Name}" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding Selected.BaseModelSource}" TextWrapping="Wrap"/><TextBlock Text="{Binding Selected.Facts.SourceUrl}" TextWrapping="Wrap"/><TextBlock Text="{Binding Selected.LastUsed,StringFormat=Last used: {0}}"/>
    <WrapPanel><Button Content="LoRAだけ挿入" Click="InsertClick"/><Button Content="LoRA + Recipe挿入" Click="RecipeClick"/><Button Content="triggerをコピー" Click="CopyTriggersClick"/><Button Content="Recipe Negative追加" Click="AppendNegativeClick"/><Button Content="Negative追加をコピー" Click="CopyNegativeClick"/><Button Content="Preset化" Click="PresetClick"/><Button Content="user metadata / Recipe保存" Click="SaveClick"/></WrapPanel>
    <TextBlock Text="user category"/><ComboBox SelectedValue="{Binding Category}" SelectedValuePath="Content"><ComboBoxItem Content="Character"/><ComboBoxItem Content="Style"/><ComboBoxItem Content="Concept"/><ComboBoxItem Content="Other"/></ComboBox>
    <CheckBox Content="お気に入り" IsChecked="{Binding Favorite}"/><TextBlock Text="preferred weight (-2..2)"/><TextBox Text="{Binding Weight,UpdateSourceTrigger=PropertyChanged}"/>
    <CheckBox Content="Base model user override" IsChecked="{Binding OverrideBaseModel}"/><TextBox Text="{Binding BaseModel,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Character / Concept canonical・Style links（1行1件、user-owned）" TextWrapping="Wrap"/><TextBox Text="{Binding Links,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="45"/>
    <CheckBox Content="trigger words user override" IsChecked="{Binding OverrideTriggers}"/><ItemsControl ItemsSource="{Binding Triggers}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><DockPanel><CheckBox IsChecked="{Binding Enabled}"/><TextBox Text="{Binding Text,UpdateSourceTrigger=PropertyChanged}"/></DockPanel><TextBlock Text="{Binding Source}" FontSize="10"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="trigger追加" Click="AddTriggerClick"/>
    <TextBlock Text="メモ"/><TextBox Text="{Binding Note,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="55"/><TextBlock Text="preview override（local path、空欄でsidecar）" TextWrapping="Wrap"/><TextBox Text="{Binding PreviewOverride,UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Text="Recipe Positive追加"/><TextBox Text="{Binding PositiveAdditions,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="45"/><TextBlock Text="Recipe Negative追加"/><TextBox Text="{Binding NegativeAdditions,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="45"/>
    <TextBlock Text="変更後は上の保存ボタンで保存してください。低優先metadata refreshはuser overrideを上書きしません。" TextWrapping="Wrap" FontSize="12"/>
   </StackPanel></ScrollViewer>
  </Grid><TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap"/>
 </Grid>
</UserControl>

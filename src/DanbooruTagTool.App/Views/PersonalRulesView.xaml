<UserControl x:Class="DanbooruTagTool.App.Views.PersonalRulesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto"><StackPanel Margin="6"><TextBlock Text="{Binding ActiveIdentity}" TextWrapping="Wrap"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
 <WrapPanel><CheckBox Content="全モデル共通" IsChecked="{Binding Global}"/><Button Content="現在モデルをscopeへ" Command="{Binding CaptureModel}"/><Button Content="保存設定を再読込" Command="{Binding Reload}"/></WrapPanel>
 <TextBlock Text="scope: model名 / hash（優先）"/><TextBox Text="{Binding ModelName,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding ModelHash,UpdateSourceTrigger=PropertyChanged}"/>
 <TextBlock Text="trigger / Positive / Negative / preferred Preset（個人設定）"/><TextBox Text="{Binding Trigger,UpdateSourceTrigger=PropertyChanged}" ToolTip="trigger"/><TextBox Text="{Binding Positive,UpdateSourceTrigger=PropertyChanged}" ToolTip="Positive additions"/><TextBox Text="{Binding Negative,UpdateSourceTrigger=PropertyChanged}" ToolTip="Negative additions"/><TextBox Text="{Binding PreferredPreset,UpdateSourceTrigger=PropertyChanged}" ToolTip="preferred Preset name"/>
 <TextBlock Text="warning / note"/><TextBox Text="{Binding Warning,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding Note,UpdateSourceTrigger=PropertyChanged}"/><Button Content="個人hintを保存" Command="{Binding AddHint}"/>
 <ListBox ItemsSource="{Binding Hints}" SelectedItem="{Binding SelectedHint}" MaxHeight="130"><ListBox.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap"><Run Text="{Binding Trigger}"/><Run Text=" / "/><Run Text="{Binding Positive}"/><Run Text=" / Negative: "/><Run Text="{Binding Negative}"/><Run Text=" / "/><Run Text="{Binding Note}"/></TextBlock></DataTemplate></ListBox.ItemTemplate></ListBox>
 <WrapPanel><Button Content="選択hintをPositiveへ追加" Command="{Binding ApplyPositive}"/><Button Content="Negativeへ追加" Command="{Binding ApplyNegative}"/><Button Content="推奨Presetを適用" Command="{Binding ApplyPreset}"/><Button Content="選択hintを削除" Command="{Binding DeleteHint}"/></WrapPanel>
 <TextBlock Text="個人blacklist: canonical / alias / raw token"/><TextBox Text="{Binding Token,UpdateSourceTrigger=PropertyChanged}"/><ComboBox ItemsSource="{Binding Severities}" SelectedItem="{Binding Severity}"/><TextBox Text="{Binding Replacement,UpdateSourceTrigger=PropertyChanged}" ToolTip="replacement suggestion"/><Button Content="blacklistを保存（上のscope/noteを使用）" Command="{Binding AddRule}"/>
 <ListBox ItemsSource="{Binding Exclusions}" SelectedItem="{Binding SelectedRule}" MaxHeight="130"><ListBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Token}"/><Run Text=" / "/><Run Text="{Binding Severity}"/><Run Text=" / "/><Run Text="{Binding Note}"/></TextBlock></DataTemplate></ListBox.ItemTemplate></ListBox><Button Content="選択blacklistを削除" Command="{Binding DeleteRule}"/>
 <TextBlock Text="Hideは個人表示のみ。Warnは診断。BlockAddは追加のみを拒否。既存rawは削除せず、モデル切替も自動挿入しません。" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
</UserControl>

<UserControl x:Class="DanbooruTagTool.App.Views.LoraQuickUseView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="OnLoaded">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12" IsEnabled="{Binding CanEdit}">
  <TextBlock Text="登録済みLoRAを現在Positiveへ追加" FontSize="18" FontWeight="SemiBold"/>
  <TextBlock Text="フォルダー登録・スキャン・metadata管理は ライブラリ > LoRA。ここは同じ選択・draftの使用画面です。" Margin="0,4,0,8"/>
  <WrapPanel><TextBox x:Name="QuickSearch" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Width="260" AutomationProperties.Name="LoRA quick-use検索"/><Button Content="検索 / 更新" Click="SearchClick" Margin="8,0,0,0"/><Button Content="前100" Click="PreviousClick"/><Button Content="次100" Click="NextClick"/></WrapPanel>
  <ComboBox ItemsSource="{Binding Assets}" SelectedItem="{Binding Selected}" HorizontalContentAlignment="Stretch" Margin="0,8" AutomationProperties.Name="登録済みLoRAを選択"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Summary}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
  <Image Source="{Binding Preview}" MaxHeight="100" Stretch="Uniform" HorizontalAlignment="Left"/>
  <TextBlock Text="{Binding Selected.Name}" FontWeight="SemiBold"/>
  <TextBlock Text="{Binding Selected.User.PreferredWeight,StringFormat=保存済みpreferred weight: {0}}"/>
  <WrapPanel><TextBlock Text="今回のweight (-2..2)" VerticalAlignment="Center"/><TextBox Text="{Binding Weight,UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="8,0" AutomationProperties.Name="LoRA現在weight"/></WrapPanel>
  <ItemsControl ItemsSource="{Binding Triggers}" Margin="0,8"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Text}" IsChecked="{Binding Enabled}" Margin="0,0,12,6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <WrapPanel><Button Content="LoRAだけ追加" Click="InsertClick"/><Button Content="LoRA + trigger・Positive追加" Click="RecipeClick"/><Button Content="Negative追加（明示）" Click="AppendNegativeClick" ToolTip="LoRAのNegative additionsを現在Negativeに追加。Positive挿入では自動追加しません。"/></WrapPanel>
  <TextBlock Text="{Binding Status}" Margin="0,8"/>
 </StackPanel></ScrollViewer>
</UserControl>

<UserControl x:Class="DanbooruTagTool.App.Views.GenerationLibraryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Loaded="OnLoaded" Foreground="#22344F" Background="#F4F7FA">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="LibraryBoolVisibility"/>
  <Style x:Key="LibraryLabel" TargetType="TextBlock"><Setter Property="Margin" Value="0,8,0,3"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="LibraryInput" TargetType="TextBox"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="4"/></Style>
 </UserControl.Resources>
 <Grid Margin="8">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
  <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="0,0,8,0">
    <TextBlock Text="画像フォルダー" FontWeight="Bold" FontSize="16"/>
    <Button Content="フォルダーを追加" Click="AddRootClick"/>
    <ListBox ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedRoot}" Height="110" Margin="0,6" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
     <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Path}" TextWrapping="Wrap"/><TextBlock Text="{Binding Enabled, StringFormat=スキャン対象: {0}}" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <WrapPanel><Button Content="すべて" Command="{Binding AllRoots}"/><Button Content="停止" Click="DisableRootClick" ToolTip="選択フォルダーのスキャンを停止。既存画像と評価は保持。"/><Button Content="再開" Click="EnableRootClick"/></WrapPanel>
    <WrapPanel><Button Content="スキャン" Command="{Binding Scan}"/><Button Content="中止" Command="{Binding CancelScan}"/><Button Content="DBバックアップ" Click="BackupClick" ToolTip="Library DBのバックアップ。画像は含みません。"/></WrapPanel>
    <TextBlock Text="検索・絞り込み" FontWeight="Bold" FontSize="16" Margin="0,12,0,4"/>
    <TextBlock Text="Prompt / Model / LoRA / メモ / ファイル名" Style="{StaticResource LibraryLabel}"/>
    <TextBox x:Name="SearchBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LibraryInput}"/>
    <CheckBox Content="お気に入りのみ" IsChecked="{Binding FavoriteFilter}" Margin="0,8"/>
    <ComboBox SelectedIndex="{Binding MetadataFilter}"><ComboBoxItem Content="metadata すべて"/><ComboBoxItem Content="metadata あり"/><ComboBoxItem Content="metadata なし / 不正"/></ComboBox>
    <TextBlock Text="並び順" Style="{StaticResource LibraryLabel}"/>
    <ComboBox SelectedIndex="{Binding SortIndex}"><ComboBoxItem Content="新しい順"/><ComboBoxItem Content="古い順"/><ComboBoxItem Content="ファイル名"/><ComboBoxItem Content="お気に入り順"/><ComboBoxItem Content="評価順"/></ComboBox>
    <Expander Header="生成条件・詳細フィルター" Margin="0,8" IsExpanded="False">
     <StackPanel>
      <TextBlock Text="Positive" Style="{StaticResource LibraryLabel}"/><TextBox Text="{Binding PositiveFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LibraryInput}"/>
      <TextBlock Text="Negative" Style="{StaticResource LibraryLabel}"/><TextBox Text="{Binding NegativeFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LibraryInput}"/>
      <TextBlock Text="Model" Style="{StaticResource LibraryLabel}"/><TextBox Text="{Binding ModelFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LibraryInput}"/>
      <TextBlock Text="Seed（完全一致）" Style="{StaticResource LibraryLabel}"/><TextBox Text="{Binding SeedFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LibraryInput}"/>
      <TextBlock Text="Sampler" Style="{StaticResource LibraryLabel}"/><TextBox Text="{Binding SamplerFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LibraryInput}"/>
      <TextBlock Text="Scheduler" Style="{StaticResource LibraryLabel}"/><TextBox Text="{Binding SchedulerFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LibraryInput}"/>
      <TextBlock Text="CFG 下限 / 上限" Style="{StaticResource LibraryLabel}"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Text="{Binding CfgMinFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LibraryInput}"/><TextBox Grid.Column="1" Text="{Binding CfgMaxFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LibraryInput}"/></Grid>
      <TextBlock Text="Width / Height" Style="{StaticResource LibraryLabel}"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Text="{Binding WidthFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LibraryInput}"/><TextBox Grid.Column="1" Text="{Binding HeightFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LibraryInput}"/></Grid>
      <TextBlock Text="LoRA" Style="{StaticResource LibraryLabel}"/><TextBox Text="{Binding LoraFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LibraryInput}"/>
      <TextBlock Text="評価の下限（0–5）" Style="{StaticResource LibraryLabel}"/><TextBox Text="{Binding RatingFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LibraryInput}"/>
      <TextBlock Text="メモ" Style="{StaticResource LibraryLabel}"/><TextBox Text="{Binding NoteFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LibraryInput}"/>
     </StackPanel>
    </Expander>
    <Button Content="検索・更新" Command="{Binding Refresh}"/>
   </StackPanel>
  </ScrollViewer>
  <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"/>
  <DockPanel Grid.Column="2" Margin="6,0">
   <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><TextBlock Text="{Binding PageSummary}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="前へ" Command="{Binding Previous}"/><Button Content="次へ" Command="{Binding Next}"/></StackPanel></DockPanel>
   <!-- Bounded SQL pages: WrapPanel creates at most 60 cards, never the whole library. -->
   <ListBox ItemsSource="{Binding Images}" SelectedItem="{Binding Selected}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="#F5F7FA" BorderThickness="0">
    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemTemplate><DataTemplate><StackPanel Width="152" Margin="3"><Border Background="#E5EAF1" Height="125"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Border><TextBlock Text="{Binding Filename}" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="10" Foreground="#626E7F"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </DockPanel>
  <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center"/>
  <DockPanel Grid.Column="4">
   <Border DockPanel.Dock="Bottom" Padding="6" BorderBrush="#B9CBD9" BorderThickness="1" Visibility="{Binding HasCompareLeft, Converter={StaticResource LibraryBoolVisibility}}">
    <StackPanel><TextBlock Text="{Binding CompareLeftSource}" FontWeight="SemiBold"/><TextBlock Text="{Binding CompareRightSource}" FontWeight="SemiBold"/>
     <WrapPanel><Button Content="左画像に保持" Command="{Binding SetCompareLeft}"/><Button Content="選択画像と比較" Command="{Binding Compare}"/></WrapPanel>
    </StackPanel>
   </Border>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="8,0,0,0">
    <WrapPanel Margin="0,8"><Button Content="作成で使う" Command="{Binding LoadInCreate}" ToolTip="この画像のPositive / Negative / 生成条件で現在値を置換します。両PromptのUndoは独立。"/><Button Content="この条件で生成" Command="{Binding GenerateRecipe}" ToolTip="この選択画像の条件で1画像生成し実画像metadataを照合。現在編集中Promptは使いません。"/><Button Content="左画像に保持" Command="{Binding SetCompareLeft}"/></WrapPanel>
    <Image Source="{Binding Preview}" Height="180" Stretch="Uniform"/>
    <TextBlock Text="{Binding SelectedPath}" TextWrapping="Wrap" FontSize="11" Margin="0,6"/>
    <WrapPanel><Button Content="画像を開く" Click="OpenImageClick" IsEnabled="{Binding HasSelection}"/><Button Content="保存場所" Click="RevealClick" IsEnabled="{Binding HasSelection}"/></WrapPanel>
    <StackPanel IsEnabled="{Binding CanAnnotate}">
     <CheckBox Content="お気に入り" IsChecked="{Binding Favorite}" Margin="0,10,0,5"/>
     <TextBlock Text="評価（未評価は空欄 / 0–5）" Style="{StaticResource LibraryLabel}"/>
     <TextBox Text="{Binding Rating, UpdateSourceTrigger=LostFocus}" Style="{StaticResource LibraryInput}"/>
     <TextBlock Text="メモ（入力ごとに保存）" Style="{StaticResource LibraryLabel}"/>
     <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65" MaxHeight="150" VerticalScrollBarVisibility="Auto"/>
    </StackPanel>
    <TextBlock Text="Positive" Style="{StaticResource LibraryLabel}"/>
    <TextBox Text="{Binding Positive, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto"/>
    <TextBlock Text="Negative" Style="{StaticResource LibraryLabel}"/>
    <TextBox Text="{Binding Negative, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto"/>

    <Expander Header="その他の画像操作 / 互換操作"><StackPanel><WrapPanel Margin="0,8"><Button Content="Negative置換" Command="{Binding RestoreNegative}"/><Button Content="Positive復元" Command="{Binding RestorePrompt}"/><Button Content="Preset化" Command="{Binding CreatePreset}"/></WrapPanel>
    <WrapPanel><Button Content="送るだけ（画像P/N置換）" Command="{Binding Send}"/><Button Content="Forge現在設定で生成（画像P/N置換）" Command="{Binding Generate}" ToolTip="Positive/Negativeを送り、Forgeの現在の設定で生成します。画像のModel/Seed等は自動適用しません。"/></WrapPanel>
    <TextBlock Text="Forgeの現在の設定で生成します。" TextWrapping="Wrap" FontSize="12" Margin="0,5"/>
    </StackPanel></Expander>
    <TextBox Text="{Binding LoraProvenance, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,5"/>
    <TextBlock Text="{Binding RestorationWarning}" TextWrapping="Wrap" FontSize="12" Margin="0,5"/>
    <TextBlock Text="{Binding RecipeStatus}" TextWrapping="Wrap" FontSize="12" Margin="0,5"/>
    <Expander Header="生成metadata（未知parameterも保持）" IsExpanded="True" Margin="0,8"><TextBox Text="{Binding RawInfotext, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="300" VerticalScrollBarVisibility="Auto"/></Expander>
    <ItemsControl ItemsSource="{Binding Differences}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#DCE3ED" BorderThickness="0,0,0,1" Padding="0,6"><StackPanel><TextBlock><Run Text="{Binding Field}"/><Run Text=" · "/><Run Text="{Binding State}"/></TextBlock><TextBlock Text="{Binding Left, StringFormat=左: {0}}" TextWrapping="Wrap"/><TextBlock Text="{Binding Right, StringFormat=右: {0}}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel>
  </ScrollViewer></DockPanel>
  <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0"/>
 </Grid>
</UserControl>

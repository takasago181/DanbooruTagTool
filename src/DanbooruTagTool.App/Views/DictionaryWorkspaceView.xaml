<UserControl x:Class="DanbooruTagTool.App.Views.DictionaryWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibilityLocal"/>
        <Style x:Key="UnifiedFacetButtonLocal" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="0,1,4,1"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="FacetChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FacetChrome" Property="Background" Value="#E8F4FF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Selected}" Value="True">
                                <Setter TargetName="FacetChrome" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="FacetChrome" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMouseOver}" Value="True"/>
                                    <Condition Binding="{Binding Selected}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="FacetChrome" Property="Background" Value="#2B72B9"/>
                            </MultiDataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FacetChrome" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UnifiedFilterToggleLocal" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,1,4,1"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="FilterChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FilterChrome" Property="Background" Value="#E8F4FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="FilterChrome" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="FilterChrome" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="FilterChrome" Property="Background" Value="#2B72B9"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FilterChrome" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="UnifiedFacetOptionTemplateLocal">
            <Button Content="{Binding Label}"
                    ToolTip="{Binding ToolTip}"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolVisibilityLocal}}"
                    Command="{Binding DataContext.ToggleBrowseFacet, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource UnifiedFacetButtonLocal}"/>
        </DataTemplate>
        <DataTemplate x:Key="DictionaryResultRowTemplateLocal">
            <Grid Margin="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding First}" ContentTemplate="{DynamicResource EntryTemplate}" VerticalAlignment="Top" MouseLeftButtonUp="DictionaryCardMouseUp"/>
                <ContentPresenter Grid.Column="1" Content="{Binding Second}" ContentTemplate="{DynamicResource EntryTemplate}" VerticalAlignment="Top" MouseLeftButtonUp="DictionaryCardMouseUp">
                    <ContentPresenter.Style>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers><DataTrigger Binding="{Binding DataContext.Second, RelativeSource={RelativeSource AncestorType={x:Type Grid}}}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style>
                    </ContentPresenter.Style>
                </ContentPresenter>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="DictionaryCardTemplateLocal">
            <ContentPresenter Content="{Binding}" ContentTemplate="{DynamicResource EntryTemplate}" MouseLeftButtonUp="DictionaryCardMouseUp"/>
        </DataTemplate>
    </UserControl.Resources>
    <Border Style="{DynamicResource PanelCard}" Padding="8">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="タグ辞書" Style="{DynamicResource PanelTitle}" FontSize="16"/><TextBlock Text="日本語・English・混在検索" Style="{DynamicResource HintText}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
                <Border Grid.Column="1" Style="{DynamicResource ToolbarCard}" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Prompt履歴" Style="{DynamicResource HintText}" VerticalAlignment="Center" Margin="0,0,6,0"/><Button Content="元に戻す" ToolTip="Promptを元に戻す" Command="{Binding DataContext.Prompt.Undo, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource CompactButton}" Margin="0,0,4,0"/><Button Content="やり直す" ToolTip="Promptをやり直す" Command="{Binding DataContext.Prompt.Redo, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource CompactButton}" Margin="0"/></StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" TextChanged="SearchChanged" AutomationProperties.Name="日本語・English・混在検索" ToolTip="日本語・English・混在検索" Padding="9,6"/>
                <Button Grid.Column="1" Content="クリア" Command="{Binding ClearQuery}" Style="{DynamicResource CompactButton}" Margin="6,0,8,0"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="{Binding ResultSummary}" Style="{DynamicResource HintText}"/><TextBlock Text="{Binding Pending}" Style="{DynamicResource HintText}"/></StackPanel>
                <Grid Grid.Column="3" MinWidth="105">
                    <ComboBox SelectedIndex="{Binding SortIndex}" IsEnabled="{Binding CanBrowseSort}" Height="30"><ComboBox.Style><Style TargetType="ComboBox"><Style.Triggers><DataTrigger Binding="{Binding IsSearching}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style><ComboBoxItem Content="使用数 ↓"/><ComboBoxItem Content="日本語名"/></ComboBox>
                    <TextBlock Text="関連度順" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsSearching, Converter={StaticResource BoolVisibilityLocal}}"/>
                </Grid>
                </Grid>
            <StackPanel Grid.Row="2" Margin="0,0,0,4">
                <Border Background="#F8FBFD" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="6,4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="検索対象" Style="{DynamicResource HintText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <WrapPanel>
                            <ToggleButton Content="すべて" IsChecked="{Binding IsSearchAll, Mode=OneWay}" Command="{Binding SetSearchTargetCommand}" CommandParameter="All" Style="{StaticResource UnifiedFilterToggleLocal}"/>
                            <ToggleButton Content="キャラ" IsChecked="{Binding IsSearchCharacter, Mode=OneWay}" Command="{Binding SetSearchTargetCommand}" CommandParameter="Character" Style="{StaticResource UnifiedFilterToggleLocal}"/>
                            <ToggleButton Content="作品" IsChecked="{Binding IsSearchCopyright, Mode=OneWay}" Command="{Binding SetSearchTargetCommand}" CommandParameter="Copyright" Style="{StaticResource UnifiedFilterToggleLocal}"/>
                            <ToggleButton Content="作者" IsChecked="{Binding IsSearchArtist, Mode=OneWay}" Command="{Binding SetSearchTargetCommand}" CommandParameter="Artist" Style="{StaticResource UnifiedFilterToggleLocal}"/>
                        </WrapPanel>
                    </DockPanel>
                </Border>
                <Border Background="#EAF4FC" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="8" Padding="7,5" Margin="0,4,0,0"
                        Visibility="{Binding ShowRelationBanner, Converter={StaticResource BoolVisibilityLocal}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="関連表示を解除" Command="{Binding ClearRelatedBrowseCommand}" Style="{DynamicResource CompactButton}" Padding="7,2" MinHeight="25" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding RelationBannerText}" FontWeight="Medium" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </StackPanel>
            <Border Grid.Row="3" Background="#F8FBFD" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="6,4" Margin="0,0,0,4" Visibility="{Binding ShowUnifiedRefinement, Converter={StaticResource BoolVisibilityLocal}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <DockPanel MinHeight="28" Visibility="{Binding ShowLocalOptions, Converter={StaticResource BoolVisibilityLocal}}">
                            <TextBlock DockPanel.Dock="Left" Text="分類" Style="{DynamicResource HintText}" Width="42" Margin="0,5,4,0"/>
                            <ItemsControl ItemsSource="{Binding LocalOptions}" ItemTemplate="{StaticResource UnifiedFacetOptionTemplateLocal}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DockPanel>
                        <DockPanel MinHeight="28">
                            <TextBlock DockPanel.Dock="Left" Text="部位" Style="{DynamicResource HintText}" Width="42" Margin="0,5,4,0"/>
                            <ItemsControl ItemsSource="{Binding BodyOptions}" ItemTemplate="{StaticResource UnifiedFacetOptionTemplateLocal}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DockPanel>
                        <DockPanel MinHeight="28">
                            <TextBlock DockPanel.Dock="Left" Text="テーマ" Style="{DynamicResource HintText}" Width="42" Margin="0,5,4,0"/>
                            <ItemsControl ItemsSource="{Binding ThemeOptions}" ItemTemplate="{StaticResource UnifiedFacetOptionTemplateLocal}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DockPanel>
                        <DockPanel MinHeight="28">
                            <TextBlock DockPanel.Dock="Left" Text="内容" Style="{DynamicResource HintText}" Width="42" Margin="0,5,4,0"/>
                            <WrapPanel>
                                <ToggleButton Content="すべて" IsChecked="{Binding IsContentAll, Mode=OneWay}" Command="{Binding SetContentIntentCommand}" CommandParameter="All" Style="{StaticResource UnifiedFilterToggleLocal}"/>
                                <ToggleButton Content="一般向け" IsChecked="{Binding IsContentGeneralPurpose, Mode=OneWay}" Command="{Binding SetContentIntentCommand}" CommandParameter="GeneralPurpose" Style="{StaticResource UnifiedFilterToggleLocal}"/>
                                <ToggleButton Content="性的" IsChecked="{Binding IsContentSexual, Mode=OneWay}" Command="{Binding SetContentIntentCommand}" CommandParameter="Sexual" Style="{StaticResource UnifiedFilterToggleLocal}"/>
                                <ToggleButton Content="◆ 深掘りのみ" IsChecked="{Binding DeepOnly, Mode=OneWay}" Command="{Binding ToggleDeepOnlyCommand}" Style="{StaticResource UnifiedFilterToggleLocal}"/>
                            </WrapPanel>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                        <Button Content="↶ 1つ戻す" Command="{Binding UndoUnifiedBrowseCommand}" Style="{DynamicResource CompactButton}" Padding="6,2" MinHeight="25" Margin="0,0,4,0"/>
                        <Button Content="全解除" Command="{Binding ClearUnifiedBrowseCommand}" Style="{DynamicResource CompactButton}" Padding="6,2" MinHeight="25" Margin="0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="DictionaryResultSurface" Grid.Row="4" Style="{DynamicResource WorkSurfaceCard}" Padding="2">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="DictionaryLeftColumn" Width="*"/><ColumnDefinition x:Name="DictionaryRightColumn" Width="0"/></Grid.ColumnDefinitions>
                    <ListBox x:Name="DictionaryList" PreviewKeyDown="DictionaryPreviewKeyDown" SelectionChanged="DictionarySelectionChanged" SizeChanged="DictionaryListSizeChanged" ItemsSource="{Binding DictionaryFirstColumn}" SelectedIndex="-1" ItemContainerStyle="{DynamicResource DictionaryRow}" ItemTemplate="{StaticResource DictionaryCardTemplateLocal}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" ScrollViewer.ScrollChanged="BrowseScrolled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Vertical"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    </ListBox>
                    <ListBox x:Name="DictionaryRightList" Grid.Column="1" Visibility="Collapsed" PreviewKeyDown="DictionaryPreviewKeyDown" SelectionChanged="DictionarySelectionChanged" ItemsSource="{Binding DictionarySecondColumn}" SelectedIndex="-1" ItemContainerStyle="{DynamicResource DictionaryRow}" ItemTemplate="{StaticResource DictionaryCardTemplateLocal}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.CanContentScroll="True" ScrollViewer.ScrollChanged="BrowseScrolled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Vertical"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    </ListBox>
                    <TextBlock Grid.ColumnSpan="2" Text="左からカテゴリを選ぶか、タグ名を検索してください。"
                               Style="{DynamicResource HintText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Visibility="{Binding ShowNeutralGuidance, Converter={StaticResource BoolVisibilityLocal}}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

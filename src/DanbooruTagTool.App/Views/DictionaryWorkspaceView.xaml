<UserControl x:Class="DanbooruTagTool.App.Views.DictionaryWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibilityLocal"/>
        <Style x:Key="UnifiedFacetButtonLocal" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,2,5,2"/>
            <Setter Property="MinHeight" Value="28"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter Property="Background" Value="#E5F2FF"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="#17345E"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="UnifiedFacetOptionTemplateLocal">
            <Button Content="{Binding Label}"
                    ToolTip="{Binding ToolTip}"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolVisibilityLocal}}"
                    Command="{Binding DataContext.ToggleBrowseFacet, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource UnifiedFacetButtonLocal}"/>
        </DataTemplate>
        <DataTemplate x:Key="DictionaryResultRowTemplateLocal">
            <Grid Margin="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding First}" ContentTemplate="{DynamicResource EntryTemplate}" MouseLeftButtonUp="DictionaryCardMouseUp"/>
                <ContentPresenter Grid.Column="1" Content="{Binding Second}" ContentTemplate="{DynamicResource EntryTemplate}" MouseLeftButtonUp="DictionaryCardMouseUp">
                    <ContentPresenter.Style>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers><DataTrigger Binding="{Binding DataContext.Second, RelativeSource={RelativeSource AncestorType={x:Type Grid}}}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style>
                    </ContentPresenter.Style>
                </ContentPresenter>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Border Style="{DynamicResource PanelCard}" Padding="12">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="タグ辞書" Style="{DynamicResource PanelTitle}" FontSize="16"/><TextBlock Text="日本語・English・混在検索" Style="{DynamicResource HintText}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
                <Border Grid.Column="1" Style="{DynamicResource ToolbarCard}" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Prompt履歴" Style="{DynamicResource HintText}" VerticalAlignment="Center" Margin="0,0,6,0"/><Button Content="元に戻す" ToolTip="Promptを元に戻す" Command="{Binding DataContext.Prompt.Undo, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource CompactButton}" Margin="0,0,4,0"/><Button Content="やり直す" ToolTip="Promptをやり直す" Command="{Binding DataContext.Prompt.Redo, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource CompactButton}" Margin="0"/></StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" TextChanged="SearchChanged" AutomationProperties.Name="日本語・English・混在検索" ToolTip="日本語・English・混在検索" Padding="9,6"/>
                <Button Grid.Column="1" Content="クリア" Command="{Binding ClearQuery}" Style="{DynamicResource CompactButton}" Margin="6,0,8,0"/>
                <TextBlock Grid.Column="2" Text="{Binding ResultSummary}" Style="{DynamicResource HintText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Grid Grid.Column="3" MinWidth="105">
                    <ComboBox SelectedIndex="{Binding SortIndex}" IsEnabled="{Binding CanBrowseSort}" Height="30"><ComboBox.Style><Style TargetType="ComboBox"><Style.Triggers><DataTrigger Binding="{Binding IsSearching}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style><ComboBoxItem Content="使用数 ↓"/><ComboBoxItem Content="日本語名"/></ComboBox>
                    <TextBlock Text="関連度順" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsSearching, Converter={StaticResource BoolVisibilityLocal}}"/>
                </Grid>
            </Grid>
            <DockPanel Grid.Row="2" Margin="0,0,0,6"><TextBlock Text="{Binding BrowseLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="  ·  " Foreground="{DynamicResource MutedInkBrush}" VerticalAlignment="Center"/><TextBlock Text="{Binding Pending}" Style="{DynamicResource HintText}" VerticalAlignment="Center"/></DockPanel>
            <Border Grid.Row="3" Background="#F8FBFD" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,6" Visibility="{Binding ShowUnifiedRefinement, Converter={StaticResource BoolVisibilityLocal}}">
                <StackPanel>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="絞り込み" Style="{DynamicResource HintText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="1つ戻す" Command="{Binding UndoUnifiedBrowseCommand}" Style="{DynamicResource CompactButton}" Padding="7,3" MinHeight="25" Width="82" Margin="8,0,4,0"/>
                            <Button Content="全解除" Command="{Binding ClearUnifiedBrowseCommand}" Style="{DynamicResource CompactButton}" Padding="7,3" MinHeight="25" Width="68" Margin="0"/>
                        </StackPanel>
                    </Grid>
                    <DockPanel Visibility="{Binding ShowLocalOptions, Converter={StaticResource BoolVisibilityLocal}}">
                        <TextBlock DockPanel.Dock="Left" Text="分類" Style="{DynamicResource HintText}" Width="44" Margin="0,7,4,0"/>
                        <ItemsControl ItemsSource="{Binding LocalOptions}" ItemTemplate="{StaticResource UnifiedFacetOptionTemplateLocal}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="部位" Style="{DynamicResource HintText}" Width="44" Margin="0,7,4,0"/>
                        <ItemsControl ItemsSource="{Binding BodyOptions}" ItemTemplate="{StaticResource UnifiedFacetOptionTemplateLocal}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="テーマ" Style="{DynamicResource HintText}" Width="44" Margin="0,7,4,0"/>
                        <ItemsControl ItemsSource="{Binding ThemeOptions}" ItemTemplate="{StaticResource UnifiedFacetOptionTemplateLocal}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="表示" Style="{DynamicResource HintText}" Width="44" Margin="0,7,4,0"/>
                        <ToggleButton Content="◆ 深掘りのみ"
                                      IsChecked="{Binding DeepOnly, Mode=OneWay}"
                                      Command="{Binding ToggleDeepOnlyCommand}"
                                      Style="{DynamicResource ModeToggleButton}"
                                      Padding="9,4" MinHeight="28" Margin="0,2,5,2"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="内容" Style="{DynamicResource HintText}" Width="44" Margin="0,7,4,0"/>
                        <WrapPanel>
                            <ToggleButton Content="すべて" IsChecked="{Binding IsContentAll, Mode=OneWay}" Command="{Binding SetContentIntentCommand}" CommandParameter="All" Style="{DynamicResource ModeToggleButton}" Padding="9,4" MinHeight="28" Margin="0,2,5,2"/>
                            <ToggleButton Content="一般向け" IsChecked="{Binding IsContentGeneralPurpose, Mode=OneWay}" Command="{Binding SetContentIntentCommand}" CommandParameter="GeneralPurpose" Style="{DynamicResource ModeToggleButton}" Padding="9,4" MinHeight="28" Margin="0,2,5,2"/>
                            <ToggleButton Content="性的" IsChecked="{Binding IsContentSexual, Mode=OneWay}" Command="{Binding SetContentIntentCommand}" CommandParameter="Sexual" Style="{DynamicResource ModeToggleButton}" Padding="9,4" MinHeight="28" Margin="0,2,5,2"/>
                        </WrapPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Grid.Row="4" Style="{DynamicResource WorkSurfaceCard}" Padding="4">
                <Grid>
                    <ListBox x:Name="DictionaryList" PreviewKeyDown="DictionaryPreviewKeyDown" SelectionChanged="DictionarySelectionChanged" SizeChanged="DictionaryListSizeChanged" ItemsSource="{Binding DictionaryRows}" SelectedIndex="-1" ItemContainerStyle="{DynamicResource DictionaryRow}" ItemTemplate="{StaticResource DictionaryResultRowTemplateLocal}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" ScrollViewer.ScrollChanged="BrowseScrolled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Vertical"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    </ListBox>
                    <TextBlock Text="左からカテゴリを選ぶか、タグ名を検索してください。"
                               Style="{DynamicResource HintText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Visibility="{Binding ShowNeutralGuidance, Converter={StaticResource BoolVisibilityLocal}}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
